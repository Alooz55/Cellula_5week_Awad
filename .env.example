# --- LLM (free options) ---
LLM_PROVIDER=openrouter          # openrouter | ollama
OPENROUTER_API_KEY=sk-or-...     # https://openrouter.ai/keys
LLM_MODEL=                       # blank = default (openrouter/free | qwen2.5-coder:7b for ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Faster-Whisper ---
WHISPER_MODEL=small              # tiny | base | small | medium | large-v3  (medium = better Arabic, slower)
WHISPER_DEVICE=auto              # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=int8        # int8 (cpu) | float16 (gpu)

# --- limits ---
MAX_ROWS=1000
SQL_TIMEOUT_SEC=5
MAX_SQL_RETRIES=2
